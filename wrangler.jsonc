{
  // Cloudflare Worker for Flightroute: the app's files are served as static assets; worker.js only
  // handles /api/*. The name must match the Worker in the Cloudflare dashboard.
  "name": "gps-tracker",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
