{
  // Cloudflare Worker for Flightroute: the app's files are served as static assets; worker.js only
  // handles /api/* (sharing routes to the library). The name must match the Worker in the Cloudflare dashboard.
  "name": "gps-tracker",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Sign-in (see supabase/SETUP.md): the same public values as in config.js. Empty means nobody can upload.
  // GITHUB_TOKEN is a secret, added in the Cloudflare dashboard, never here.
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_KEY": "",
    "GITHUB_REPO": "robfoy-cloud/GPS-tracker"
  }
}
